# Database
DATABASE_URL=postgresql://doculens:doculens@localhost:5433/doculens

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=doculens
S3_SECRET_KEY=doculens123
S3_BUCKET=doculens-documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI Provider — "gemini" (free) or "openai"
AI_PROVIDER=gemini

# Google Gemini (default — free tier)
GOOGLE_AI_API_KEY=your-gemini-api-key

# OpenAI (optional — if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Auth: TDACorp identity v2 (OIDC). Register a web client on identity with redirect URI
# ${APP_ORIGIN}/api/auth/callback and post-logout URI ${APP_ORIGIN}/login, keep the private JWK here.
OIDC_ISSUER=https://identity.tdacorp.in
OIDC_CLIENT_ID=tdaid_c_...
OIDC_KID=k1
OIDC_PRIVATE_JWK={"kty":"OKP","crv":"Ed25519",...}
OIDC_COOKIE_SECRET=at-least-32-random-bytes
APP_ORIGIN=http://localhost:3000

# Pusher (real-time updates)
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=ap2
NEXT_PUBLIC_PUSHER_KEY=your-key
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# Inngest (optional for local dev — dev server auto-discovers)
# INNGEST_EVENT_KEY=your-event-key
# INNGEST_SIGNING_KEY=your-signing-key
